      "width": 1160,
      "height": 828,
      "backgroundColor": "transparent",
      "strokeColor": "#14130f",
      "strokeWidth": 2,
      "createdAt": "2026-07-31T14:13:55.726Z",
      "updatedAt": "2026-07-31T14:13:55.726Z",
