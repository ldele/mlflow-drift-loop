    {
      "id": "lede",
      "type": "text",
      "x": 152,
      "y": 196,
      "width": 680,
      "height": 40,
      "strokeColor": "#55534d",
      "text": "A monitoring loop that catches a model going stale — it tracks a champion, measures drift,\nand retrains a challenger, promoting it only when it wins on unseen data.",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-31T08:46:58.434Z",
      "updatedAt": "2026-07-31T08:46:58.434Z",
      "version": 1,
      "rev": 5,
      "origin": "agent"
    },
